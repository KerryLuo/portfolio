# Copy to .env for local development. Never commit the real file.

# "production" makes the contact form fail loudly if email isn't configured,
# instead of just logging messages to the console.
ENVIRONMENT=development

# Comma-separated origins allowed to call the API from a browser.
FRONTEND_ORIGIN=http://localhost:5173,https://kerryluo.github.io

# --- Contact form (https://resend.com) ---
# Without RESEND_API_KEY, messages are only logged to the console (dev only).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a verified sender in Resend. The default works for testing, but can
# only deliver to the email address your Resend account was created with.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- GitHub activity ---
GITHUB_USERNAME=KerryLuo
# Optional. Without it the heatmap reads the calendar from your public profile
# page, which already matches github.com (including private contributions if
# "Include private contributions" is on). A token with no scopes switches to the
# official GraphQL API instead, which is more robust than parsing HTML.
GITHUB_TOKEN=
